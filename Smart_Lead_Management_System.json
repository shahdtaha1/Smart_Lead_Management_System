    {
      "parameters": {
        "sendTo": "staha5958@gmail.com",
        "subject": "[Daily Report] Smart Lead Processing Summary",
        "message": "==<div style=\"font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif; color: #222; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background-color: #1a73e8; color: #ffffff; padding: 16px 20px;\">\n    <h2 style=\"margin: 0; font-size: 20px;\">📊 Daily Lead Automation Report</h2>\n  </div>\n  \n  <div style=\"padding: 20px;\">\n    <p style=\"margin-top: 0;\">Hello Admin,</p>\n    <p>Here is the automated summary of processed leads for today:</p>\n    \n    {{\n      (() => {\n        // دالة تنظيف وتوحيد شكل البيانات إلى مصفوفة\n        const cleanData = (field) => {\n          if (!field) return [];\n          if (Array.isArray(field)) return field.flatMap(item => typeof item === 'string' ? item.split(',') : item).map(s => String(s).trim());\n          if (typeof field === 'string') return field.split(',').map(s => s.trim());\n          return [field];\n        };\n\n        const ids = cleanData($json.appended_Lead_ID);\n        const names = cleanData($json.appended_Name);\n        const companies = cleanData($json.appended_Company);\n        const services = cleanData($json.appended_Service);\n        const budgets = cleanData($json.appended_Budget);\n        const emails = cleanData($json.appended_Email);\n\n        const totalLeads = names.length;\n\n        let tableRows = '';\n        for (let i = 0; i < totalLeads; i++) {\n          tableRows += `\n            <tr style=\"border-bottom: 1px solid #eee;\">\n              <td style=\"padding: 10px; font-weight: bold; color: #555;\">${ids[i] || 'N/A'}</td>\n              <td style=\"padding: 10px;\">${names[i] || 'N/A'}</td>\n              <td style=\"padding: 10px;\">${companies[i] || 'N/A'}</td>\n              <td style=\"padding: 10px;\">${services[i] || 'N/A'}</td>\n              <td style=\"padding: 10px; color: #2e7d32; font-weight: bold;\">$${budgets[i] || '0'}</td>\n              <td style=\"padding: 10px;\">${emails[i] || 'N/A'}</td>\n            </tr>\n          `;\n        }\n\n        return `\n          <div style=\"background-color: #f0f4f9; padding: 10px 15px; border-radius: 6px; margin-bottom: 15px; font-weight: bold; color: #1a73e8;\">\n            Total Processed Leads: ${totalLeads}\n          </div>\n\n          <table style=\"width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;\">\n            <thead>\n              <tr style=\"background-color: #f8f9fa; border-bottom: 2px solid #ddd;\">\n                <th style=\"padding: 10px;\">ID</th>\n                <th style=\"padding: 10px;\">Name</th>\n                <th style=\"padding: 10px;\">Company</th>\n                <th style=\"padding: 10px;\">Service</th>\n                <th style=\"padding: 10px;\">Budget</th>\n                <th style=\"padding: 10px;\">Email</th>\n              </tr>\n            </thead>\n            <tbody>\n              ${tableRows}\n            </tbody>\n          </table>\n        `;\n      })()\n    }}\n\n    <br />\n    <p style=\"font-size: 12px; color: #777; border-top: 1px solid #eee; padding-top: 10px; margin-bottom: 0;\">\n      Automatic confirmation emails have been sent to all corresponding leads.\n    </p>\n  </div>\n</div>",
        "options": {}
      },
